diff --git a/cmake/webgpu_artifact.cmake b/cmake/webgpu_artifact.cmake
index c764c03..0d61dd7 100644
--- a/cmake/webgpu_artifact.cmake
+++ b/cmake/webgpu_artifact.cmake
@@ -34,9 +34,12 @@ function(mdkr_select_wgpu_artifact os cpu abi out_supported out_asset out_sha ou
             else()
                 set(_supported FALSE)
             endif()
+        elseif(_cpu MATCHES "^(arm64|aarch64)$")
+            # BarrelPad: iOS device prebuilt from wgpu-native v29.0.1.1
+            set(_asset "wgpu-ios-aarch64-release.zip")
+            set(_sha "e36c9913b9e5095a530fa9121c50b16a4e3dd020e1eebf601f2f47ce24d56941")
         else()
             set(_supported FALSE)
-            set(_reason "iOS device wgpu not enabled; set MDKR_IOS_SIMULATOR=ON for Simulator")
         endif()
     elseif(os STREQUAL "Linux" AND _abi STREQUAL "gnu")
         if(_cpu MATCHES "^(arm64|aarch64)$")
