@@ -471,9 +483,16 @@ void positionOverlayWindow(const ImGuiViewport &viewport, float uiScale) {
                    * uiScale;
     if (width > viewport.Size.x) width = viewport.Size.x;
     if (height > viewport.Size.y) height = viewport.Size.y;
+#if defined(__APPLE__) && TARGET_OS_IOS
+    /* iPad: sit the panel a little higher so it never reaches the bottom-left
+     * analog-stick zone; the touch controls hide while it is open anyway. */
+    const float overlayCenterY = 0.42f;
+#else
+    const float overlayCenterY = 0.5f;
+#endif
     ImGui::SetNextWindowPos(
         ImVec2(viewport.Pos.x + viewport.Size.x * 0.5f,
-               viewport.Pos.y + viewport.Size.y * 0.5f),
+               viewport.Pos.y + viewport.Size.y * overlayCenterY),
         ImGuiCond_Always, ImVec2(0.5f, 0.5f));
     ImGui::SetNextWindowSize(ImVec2(width, height), ImGuiCond_Always);
 }
diff --git a/platform/app/ui_settings.cpp b/platform/app/ui_settings.cpp
index 527d34c..edb9916 100644
--- a/platform/app/ui_settings.cpp
+++ b/platform/app/ui_settings.cpp
@@ -18,6 +18,15 @@
 #include <cstring>
 #include <string>

+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+
+#if defined(__APPLE__) && TARGET_OS_IOS
+/* BarrelPad: weak hook into the UIKit touch shell; NULL elsewhere. */
+extern "C" __attribute__((weak)) void platform_ios_touch_set_scale(float scale);
+#endif
+
 namespace {

 // --- Status line -----------------------------------------------------------
@@ -40,6 +49,11 @@ bool g_uiScaleInitialized = false;
 bool g_uiScaleDirty = false;
 float g_uiScaleEdit = 1.0f;
 std::string g_uiScaleError;
+#if defined(__APPLE__) && TARGET_OS_IOS
+bool g_touchScaleInitialized = false;
+bool g_touchScaleDirty = false;
+float g_touchScaleEdit = 1.0f;
+#endif
 bool g_frameLimitRectValid = false;
 ImVec2 g_frameLimitRectMin;
 ImVec2 g_frameLimitRectMax;
@@ -923,6 +937,47 @@ bool Settings_draw(SDL_Window *window, bool compact) {
                 "Scales text and controls together after you release the slider. "
                 "Supported range: 0.75x to 2.00x. For touch, use 1.25x or larger.");
         }
+#if defined(__APPLE__) && TARGET_OS_IOS
+        /* BarrelPad: on-screen touch overlay size. The UIKit shell owns the
+         * overlay; this row only persists the value and nudges it live. */
+        if (!g_touchScaleInitialized) {
+            g_touchScaleEdit = static_cast<float>(
+                std::atof(AppConfig::get("touch_control_scale", "1.0").c_str()));
+            if (g_touchScaleEdit < 0.75f) g_touchScaleEdit = 0.75f;
+            if (g_touchScaleEdit > 1.5f) g_touchScaleEdit = 1.5f;
+            g_touchScaleInitialized = true;
+            g_touchScaleDirty = false;
+        }
+        ImGui::TextUnformatted("Touch control size");
+        ImGui::SetNextItemWidth(ui::kControlWidth());
+        const bool touchScalePreviewChanged = ImGui::SliderFloat(
+            "##touch-scale", &g_touchScaleEdit, 0.75f, 1.5f, "%.2fx",
+            ImGuiSliderFlags_AlwaysClamp);
+        if (AppUi_deferredCommit(touchScalePreviewChanged,
+                                 ImGui::IsItemDeactivatedAfterEdit(),
+                                 &g_touchScaleDirty)) {
+            if (platform_ios_touch_set_scale) {
+                platform_ios_touch_set_scale(g_touchScaleEdit);
+            }
+            char value[32];
+            std::snprintf(value, sizeof(value), "%.2f",
+                          static_cast<double>(g_touchScaleEdit));
+            const AppConfig::PersistResult persist =
+                AppConfig::setAndSave("touch_control_scale", value);
+            if (AppConfig::persistResultApplied(persist)) {
+                g_touchScaleDirty = false;
+                setStatus("Touch control size saved.", AppTheme::good());
+                changed = true;
+            } else {
+                setStatus("Touch control size could not be saved.", AppTheme::bad());
+            }
+        }
+        if (!compact) {
+            ui::TextSubtleWrapped(
+                "Scales the on-screen touch buttons and stick after you release "
+                "the slider. Supported range: 0.75x to 1.50x.");
+        }
+#endif
         ui::Gap(ui::kGapS);
     }
