+static int gc_port_connected(int port) {
+    return port >= 0 && port < DKR_MAXPADS && s_gc[port] != NULL &&
+           SDL_GameControllerGetAttached(s_gc[port]) == SDL_TRUE;
+}
+
+#if defined(BARRELPAD_IOS)
+static void gc_reconcile_close_slot(int slot, int32_t instanceId,
+                                    const char *reason) {
+    char name[128];
+    const char *controllerName =
+        s_gc[slot] != NULL ? SDL_GameControllerName(s_gc[slot]) : NULL;
+    snprintf(name, sizeof(name), "%s",
+             controllerName != NULL ? controllerName : "unknown");
+    if (s_gc[slot] != NULL) {
+        (void)platform_pad_rumble(slot, 0);
+        SDL_GameControllerClose(s_gc[slot]);
+    }
+    s_gc[slot] = NULL;
+    s_gcIsVirtual[slot] = 0;
+    s_rumbleSupported[slot] = -1;
+    s_rumbleRequested[slot] = 0;
+    memset(&s_controllerSource[slot], 0, sizeof(s_controllerSource[slot]));
+    fprintf(stderr,
+            "[SDL] controller reconcile reason=%s action=release-close "
+            "slot=P%d instance=%d name=%s\n",
+            reason, slot + 1, (int)instanceId, name);
+}
+
+static int gc_reconcile(const char *reason) {
+    BarrelPadControllerSlotChanges changes;
+    int32_t oldInstanceIds[BARRELPAD_CONTROLLER_SLOT_COUNT];
+    int32_t *currentInstanceIds = NULL;
+    int *currentDeviceIndexes = NULL;
+    int currentCount = 0;
+    int changed = 0;
+    const int joystickCount = SDL_NumJoysticks();
+
+    SDL_GameControllerUpdate();
+    if (joystickCount > 0) {
+        currentInstanceIds = (int32_t *)calloc(
+            (size_t)joystickCount, sizeof(*currentInstanceIds));
+        currentDeviceIndexes = (int *)calloc(
+            (size_t)joystickCount, sizeof(*currentDeviceIndexes));
+        if (currentInstanceIds == NULL || currentDeviceIndexes == NULL) {
+            fprintf(stderr,
+                    "[SDL] controller reconcile reason=%s action=enumerate-failure "
+                    "error=out-of-memory\n",
+                    reason);
+            free(currentInstanceIds);
+            free(currentDeviceIndexes);
+            return 0;
+        }
+    }
+
+    for (int deviceIndex = 0; deviceIndex < joystickCount; ++deviceIndex) {
+        SDL_JoystickID instanceId;
+        if (!SDL_IsGameController(deviceIndex)) {
+            continue;
+        }
+        instanceId = SDL_JoystickGetDeviceInstanceID(deviceIndex);
+        if (instanceId < 0) {
+            fprintf(stderr,
+                    "[SDL] controller reconcile reason=%s action=enumerate-skip "
+                    "device=%d error=%s\n",
+                    reason, deviceIndex, SDL_GetError());
+            continue;
+        }
+        currentInstanceIds[currentCount] = (int32_t)instanceId;
+        currentDeviceIndexes[currentCount] = deviceIndex;
+        ++currentCount;
+    }
+
+    for (int slot = 0; slot < DKR_MAXPADS; ++slot) {
+        SDL_Joystick *joystick;
+        SDL_JoystickID actualInstanceId;
+        if (s_gc[slot] == NULL) {
+            continue;
+        }
+        joystick = SDL_GameControllerGetJoystick(s_gc[slot]);
+        actualInstanceId = joystick != NULL ? SDL_JoystickInstanceID(joystick) : -1;
+        if (SDL_GameControllerGetAttached(s_gc[slot]) != SDL_TRUE ||
+            actualInstanceId < 0 ||
+            s_gcSlots.instanceIds[slot] != (int32_t)actualInstanceId) {
+            const int32_t staleInstanceId = s_gcSlots.instanceIds[slot];
+            gc_reconcile_close_slot(slot, staleInstanceId, reason);
+            s_gcSlots.instanceIds[slot] = BARRELPAD_CONTROLLER_ID_NONE;
+            changed = 1;
+        }
+    }
+
+    memcpy(oldInstanceIds, s_gcSlots.instanceIds, sizeof(oldInstanceIds));
+    changes = BarrelPad_ControllerSlotsReconcile(
+        &s_gcSlots, currentInstanceIds, (size_t)currentCount);
+
+    for (int slot = 0; slot < DKR_MAXPADS; ++slot) {
+        if ((changes.releasedMask & (1u << slot)) != 0) {
+            gc_reconcile_close_slot(slot, oldInstanceIds[slot], reason);
+            changed = 1;
+        }
+    }
+
+    for (int slot = 0; slot < DKR_MAXPADS; ++slot) {
+        SDL_GameController *controller;
+        SDL_Joystick *joystick;
+        SDL_JoystickID actualInstanceId;
+        int deviceIndex = -1;
+        const int32_t desiredInstanceId = s_gcSlots.instanceIds[slot];
+        if ((changes.assignedMask & (1u << slot)) == 0) {
+            continue;
+        }
+        for (int i = 0; i < currentCount; ++i) {
+            if (currentInstanceIds[i] == desiredInstanceId) {
+                deviceIndex = currentDeviceIndexes[i];
+                break;
+            }
+        }
+        controller = deviceIndex >= 0 ? SDL_GameControllerOpen(deviceIndex) : NULL;
+        joystick = controller != NULL ? SDL_GameControllerGetJoystick(controller) : NULL;
+        actualInstanceId = joystick != NULL ? SDL_JoystickInstanceID(joystick) : -1;
+        if (controller == NULL ||
+            SDL_GameControllerGetAttached(controller) != SDL_TRUE ||
+            actualInstanceId != desiredInstanceId) {
+            const char *deviceName = deviceIndex >= 0 ?
+                SDL_GameControllerNameForIndex(deviceIndex) : NULL;
+            fprintf(stderr,
+                    "[SDL] controller reconcile reason=%s action=open-failure "
+                    "slot=P%d device=%d instance=%d name=%s error=%s\n",
+                    reason, slot + 1, deviceIndex, (int)desiredInstanceId,
+                    deviceName != NULL ? deviceName : "unknown",
+                    SDL_GetError());
+            if (controller != NULL) {
+                SDL_GameControllerClose(controller);
+            }
+            s_gcSlots.instanceIds[slot] = BARRELPAD_CONTROLLER_ID_NONE;
+            continue;
+        }
+
+        s_gc[slot] = controller;
+        s_gcIsVirtual[slot] = 0;
+#if SDL_VERSION_ATLEAST(2, 0, 14)
+        s_gcIsVirtual[slot] = SDL_JoystickIsVirtual(deviceIndex) ? 1 : 0;
+#endif
+        s_rumbleSupported[slot] = -1;
+        s_rumbleRequested[slot] = 0;
+        memset(&s_controllerSource[slot], 0, sizeof(s_controllerSource[slot]));
+        fprintf(stderr,
+                "[SDL] controller reconcile reason=%s action=assign-open "
+                "slot=P%d device=%d instance=%d name=%s\n",
+                reason, slot + 1, deviceIndex, (int)desiredInstanceId,
+                SDL_GameControllerName(controller) != NULL ?
+                    SDL_GameControllerName(controller) : "unknown");
+        changed = 1;
+    }
+
+    if (changed || strcmp(reason, "active-check") != 0) {
+        fprintf(stderr,
+                "[SDL] controller reconcile reason=%s current=%d changed=%d\n",
+                reason, currentCount, changed);
+        ios_notify_physical_controller_state();
+    }
+    free(currentInstanceIds);
+    free(currentDeviceIndexes);
+    return changed;
+}
+#endif
