+/* ChimpPad iOS entry via SDL's UIKit application lifecycle. */
+#include <SDL.h>
+#include <SDL_main.h>
+
+/* Avoid redefining main when we include SDL_main.h */
+#ifdef main
+#undef main
+#endif
+
+/* main_app.cpp provides SDL_main under MDKR_APP. */
+extern int SDL_main(int argc, char *argv[]);
+
+int main(int argc, char *argv[]) {
+    return SDL_UIKitRunApp(argc, argv, SDL_main);
+}
