+            .rect = {.x = 0.86f, .y = 0.00f, .w = 0.10f, .h = 0.06f},
+        };
+    } else {
+        /* Tablet: more margin, slightly larger C cluster. */
+        dst[n++] = (ChimpPadControlSpec){
+            .action = kChimpPadActionA,
+            .label = "A",
+            .rect = {.x = 0.78f, .y = 0.50f, .w = 0.12f, .h = 0.20f},
