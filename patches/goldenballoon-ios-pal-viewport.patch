         return;
     }
 
+    applyPalViewportOffsets = osTvType == OS_TV_TYPE_PAL;
+#ifdef NATIVE_PORT
+    /*
+     * Retail PAL draws into a taller 320x264 framebuffer and shifts the camera
+     * four logical pixels left for the analogue VI aperture. On a modern host
+     * the display policy already owns aspect fitting and letterboxing. Scaling
+     * that television adjustment to a phone turns the four-pixel shift into a
+     * 35-pixel right gutter at 2796px, while the taller scissor spills into one
+     * side of forced-aspect letterboxing. Normalize only the ordinary native
+     * world viewport; the framed VIEWPORT_EXTRA_BG path returned above and all
+     * PAL simulation/content policy remain unchanged.
+     */
+    if (applyPalViewportOffsets) {
+        videoHeight = SCREEN_HEIGHT;
+        applyPalViewportOffsets = FALSE;
+    }
+#endif
+
